# DUITGOO Environment Variables
# Duplicate this file to .env and adjust as necessary for local development if overriding defaults

# --- Backend Services (Rust) ---
# Each service checks DATABASE_URL, falling back to a hardcoded string if not set.
# Example for identity service override:
# DATABASE_URL=postgres://duitgoo_user:duitgoo_password@localhost:5432/identity_db

# NATS JetStream URL
# NATS_URL=nats://localhost:4222

# Service Port Override (Optional)
# SERVER_PORT=8080

# --- Infrastructure ---
# Used in docker-compose.yml
POSTGRES_USER=duitgoo_user
POSTGRES_PASSWORD=duitgoo_password
POSTGRES_DB=duitgoo_db

# --- Frontend ---
# Vite environment variables must be prefixed with VITE_
# VITE_API_URL=http://localhost:8000
