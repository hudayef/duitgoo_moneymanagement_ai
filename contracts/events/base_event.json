    "event_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string"
    },
    "version": {
      "type": "integer"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": "string"
    },
    "business_id": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    }
  },
